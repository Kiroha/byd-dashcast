    <!-- v0.9.81 — Diag status pill colors -->
    <!-- Active-preset card fill. The green is the semantic — this preset is RUNNING — and it needs a
         night twin, which the hard-coded #C4ECCA it replaces did not have. Paired with
         md_status_ok as the stroke, like md_primary_container is paired with md_primary. -->
    <color name="md_active_container">#C4ECCA</color>

    <!-- Status pill tones. Alphas match the ratios the single hard-coded pill already
         used (0x1F fill, 0x56 stroke); the colours now come from the status family so
         they follow the night theme, which the hard-coded #2BD576 never did. -->
    <color name="md_pill_ok_fill">#1F2E7D32</color>
    <color name="md_pill_ok_stroke">#562E7D32</color>
    <color name="md_pill_off_fill">#1F74777F</color>
    <color name="md_pill_off_stroke">#5674777F</color>
    <!-- Warn pill: a state the API cannot see, not a fault. Fill and stroke follow the sibling
         recipe (12% / 34% of the status colour), but the TEXT does not use md_status_warn: on its
         own tinted ground #E65100 measures 2.81:1, worse than the badge this replaces. #A63A00 is
         the same hue two steps darker and measures 4.83:1, which clears AA for 11sp bold. -->
    <color name="md_pill_warn_fill">#1FE65100</color>
    <color name="md_pill_warn_stroke">#56E65100</color>
    <color name="md_pill_warn_text">#A63A00</color>

    <color name="md_status_ok">#2E7D32</color>
    <color name="md_status_warn">#E65100</color>
    <color name="md_status_err">#BA1A1A</color>
