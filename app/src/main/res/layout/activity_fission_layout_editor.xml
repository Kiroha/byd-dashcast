<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_fission_editor"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_surface_container"
        app:title="@string/fission_editor_title"
        app:navigationIcon="@drawable/ic_arrow_back"/>

    <!-- Canvas : ratio 1920×720 est géré par onMeasure -->
    <com.byd.dashcast.fission.ClusterCanvasView
        android:id="@+id/fission_canvas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Canvas action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fission_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/fission_editor_clear"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fission_save"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/fission_editor_save"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/md_primary"
            android:textColor="@color/md_on_primary"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline_variant"/>

    <!-- Saved layouts list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ll_fission_layouts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"/>

    </ScrollView>

</LinearLayout>
