<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.2.43-beta — Voice PoC panel (Diagnostic > Voice).

  Step 1/3 of the voice control roadmap: this panel only validates that the
  microphone is reachable from a DashCast foreground service on each DiLink
  platform. No machine learning here. Wake word (openWakeWord) lands in
  v1.2.44, ASR (Vosk) in v1.2.45.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/md_surface_container"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_btn_speak_now"
                        android:contentDescription="@null"
                        app:tint="@color/md_primary"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/diag_voice_header_title"
                        android:textColor="@color/md_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_voice_state_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diag_voice_state_idle"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="@drawable/bg_beta_pill"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/diag_voice_header_subtitle"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tv_voice_sample_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/diag_voice_sample_rate_fmt"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_voice_toggle"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diag_voice_btn_start"/>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tv_voice_run_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diag_voice_stats_idle"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="12sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- VU meter card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/md_surface_container"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diag_voice_meter_label"
                    android:textColor="@color/md_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <!-- RMS bar (running average) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/diag_voice_meter_rms"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="12sp"/>

                <ProgressBar
                    android:id="@+id/pb_voice_rms"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="2dp"
                    android:max="32767"
                    android:progress="0"
                    android:progressTint="@color/md_primary"
                    android:progressBackgroundTint="@color/md_surface_container_high"/>

                <!-- Peak bar (per frame) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/diag_voice_meter_peak"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="12sp"/>

                <ProgressBar
                    android:id="@+id/pb_voice_peak"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="2dp"
                    android:max="32767"
                    android:progress="0"
                    android:progressTint="@color/md_tertiary"
                    android:progressBackgroundTint="@color/md_surface_container_high"/>

                <TextView
                    android:id="@+id/tv_voice_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/diag_voice_stats_idle"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hint card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/diag_voice_hint"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
