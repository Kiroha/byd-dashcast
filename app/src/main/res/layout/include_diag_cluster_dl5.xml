<?xml version="1.0" encoding="utf-8"?>
<!--
    Cluster DL5 — recon panel (v1.2.37).
    Phase 1: non-destructive probing of every shell verb, compat ID, settings
    key and service surface relevant to cluster app resize/move on DiLink 5.
    No live cluster launch from this panel — pure recon.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_outline_variant"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_science"
                        app:tint="@color/md_primary"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diag_dl5_cluster_header_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView
                            android:id="@+id/tv_dl5_cluster_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diag_dl5_cluster_header_subtitle"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_on_surface_variant"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Status pills row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:id="@+id/tv_dl5_cluster_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="6dp" android:paddingBottom="6dp"
                        android:background="@drawable/bg_beta_pill"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:text="@string/diag_dl5_cluster_pill_unknown"/>
                    <View
                        android:layout_width="0dp" android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:id="@+id/tv_dl5_cluster_counters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/md_on_surface_variant"
                        android:text="@string/diag_dl5_cluster_counters_idle"/>
                </LinearLayout>

                <!-- Action row 1 — recon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dl5_cluster_run_all"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diag_dl5_cluster_run_all"
                        app:icon="@drawable/ic_science"
                        app:iconGravity="textStart"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dl5_cluster_copy_report"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/diag_dl5_cluster_copy_report"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dl5_cluster_send_telegram"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/diag_dl5_cluster_send_telegram"/>
                </LinearLayout>

                <!-- Action row 2 — VD pipeline test (DL5 only) -->
                <LinearLayout
                    android:id="@+id/ll_dl5_cluster_fission_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dl5_cluster_test_fission"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diag_dl5_cluster_test_vd"
                        app:icon="@drawable/ic_science"
                        app:iconGravity="textStart"
                        app:backgroundTint="@color/md_tertiary"
                        android:textColor="@color/md_on_tertiary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/diag_dl5_cluster_test_vd_hint"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/md_on_surface_variant"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Test list -->
        <LinearLayout
            android:id="@+id/ll_dl5_cluster_test_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
