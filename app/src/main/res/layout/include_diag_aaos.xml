<?xml version="1.0" encoding="utf-8"?>
<!-- AAOS (DX_BYD_AUTO) cluster diagnostic panel. Dev tool: text in English / set in code. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AAOS cluster diagnostic (DX_BYD_AUTO)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_surface"
            tools:ignore="HardcodedText"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="One tap captures the full cluster environment (displays, car_service, services, HALs), pulls candidate cluster/nav system APKs for reverse engineering, runs the AAOS gate experiments, and uploads ONE zip to the support Telegram topic. Live progress is shown so you can see it isn't stuck (~30–90 s)."
            android:textSize="13sp"
            android:textColor="@color/md_on_surface_variant"
            tools:ignore="HardcodedText"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_aaos_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
