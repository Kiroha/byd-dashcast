<?xml version="1.0" encoding="utf-8"?>
<!--
    DiagActivity — M3 redesign (v0.9.88).
    Tests from previous versions have been wiped; new diagnostic tools will be added
    here from scratch. This is intentionally a clean slate with only the nav rail
    and a placeholder hero card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="?attr/colorSurface"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw">

    <!-- ============= Nav rail ============= -->
    <LinearLayout
        android:id="@+id/ll_nav_rail_diag"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/md_surface_container_low"
        android:paddingTop="14dp" android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/iv_nav_logo_diag"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name"
            android:clickable="true" android:focusable="true"/>

        <ImageView
            android:id="@+id/nav_apps_diag"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:src="@drawable/ic_apps"
            android:padding="10dp"
            android:contentDescription="@string/main_nav_apps"
            android:clickable="true" android:focusable="true"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/main_nav_apps"
            android:textSize="10sp" android:textColor="@color/md_on_surface_variant"
            android:layout_marginTop="2dp"/>

        <ImageView
            android:id="@+id/nav_settings_diag"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/ic_tune"
            android:padding="10dp"
            android:contentDescription="@string/main_nav_settings"
            android:clickable="true" android:focusable="true"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/main_nav_settings"
            android:textSize="10sp" android:textColor="@color/md_on_surface_variant"
            android:layout_marginTop="2dp"/>

        <ImageView
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/ic_stethoscope"
            android:padding="10dp"
            android:background="@drawable/bg_nav_pill_active"
            android:contentDescription="@string/main_nav_diag"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/main_nav_diag"
            android:textSize="10sp" android:textColor="@color/md_primary"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>

        <ImageView
            android:id="@+id/nav_sysinfo_diag"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/ic_info"
            android:padding="10dp"
            android:contentDescription="@string/main_nav_sysinfo"
            android:clickable="true" android:focusable="true"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/main_nav_sysinfo"
            android:textSize="10sp" android:textColor="@color/md_on_surface_variant"
            android:layout_marginTop="2dp"/>

        <ImageView
            android:id="@+id/nav_log_diag"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/ic_notes"
            android:padding="10dp"
            android:contentDescription="@string/main_nav_log"
            android:clickable="true" android:focusable="true"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/main_nav_log"
            android:textSize="10sp" android:textColor="@color/md_on_surface_variant"
            android:layout_marginTop="2dp"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>

    <!-- ============= Main area ============= -->
    <LinearLayout
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="20dp" android:paddingBottom="0dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/main_nav_diag"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/md_on_surface_variant"/>
        </LinearLayout>

        <!-- Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs_diag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicatorColor="@color/md_primary"
            app:tabSelectedTextColor="@color/md_primary"
            app:tabTextColor="@color/md_on_surface_variant"
            app:tabRippleColor="@color/md_surface_container_high"
            app:tabBackground="@android:color/transparent">
            <com.google.android.material.tabs.TabItem
                android:text="@string/diag_tab_cluster"/>
            <com.google.android.material.tabs.TabItem
                android:text="@string/diag_tab_display"/>
            <com.google.android.material.tabs.TabItem
                android:text="@string/diag_tab_adb_local"/>
            <com.google.android.material.tabs.TabItem
                android:text="@string/diag_tab_system"/>
            <com.google.android.material.tabs.TabItem
                android:text="@string/diag_tab_adas"/>
            <com.google.android.material.tabs.TabItem
                android:text="@string/diag_tab_beta_engine"/>
            <com.google.android.material.tabs.TabItem
                android:text="@string/diag_tab_dilink5"/>
            <com.google.android.material.tabs.TabItem
                android:text="Sniffer"
                tools:ignore="HardcodedText"/>
        </com.google.android.material.tabs.TabLayout>

        <!-- Content frame: only one panel visible at a time. Filled in DiagActivity. -->
        <FrameLayout
            android:id="@+id/fl_diag_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:paddingBottom="20dp">

            <!-- Beta Engine panel (default visible) -->
            <include
                android:id="@+id/panel_beta_engine"
                layout="@layout/include_diag_beta_engine"/>

            <!-- DiLink 5 dedicated diagnostic panel -->
            <include
                android:id="@+id/panel_dilink5"
                layout="@layout/include_diag_dilink5"/>

            <!-- RE Sniffer dedicated diagnostic panel (build 181) -->
            <include
                android:id="@+id/panel_sniffer"
                layout="@layout/include_diag_sniffer"/>

            <!-- ADAS show/hide dedicated diagnostic panel -->
            <include
                android:id="@+id/panel_adas"
                layout="@layout/include_diag_adas"/>

            <!-- All other tabs share the same "coming soon" panel — instantiated and toggled by DiagActivity -->
            <include
                android:id="@+id/panel_coming_soon"
                layout="@layout/include_diag_coming_soon"/>

        </FrameLayout>
    </LinearLayout>
</LinearLayout>
