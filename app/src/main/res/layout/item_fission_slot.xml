<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="4dp"
    android:background="@color/md_surface_container">

    <TextView
        android:id="@+id/tv_fission_slot_label"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/md_on_surface"
        android:padding="4dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fission_slot_resize"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="@string/fission_slot_resize"
        android:textSize="11sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fission_slot_close"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="✕"
        android:textSize="14sp"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@android:color/transparent"
        android:textColor="@color/md_error"/>

</LinearLayout>
