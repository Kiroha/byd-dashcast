<?xml version="1.0" encoding="utf-8"?>
<!--
    ADAS — diagnostic panel.
    Two tests wired on AutoContainer sendInfo codes 12 (show) / 13 (hide).
    Codes confirmed identical across all DiLink platforms (DL3/Di4/DL5/DL6)
    in com.byd.clusterdebug v1.6.1.4 — only the binder service name differs
    (Auto_container on DL3/Di4, auto_container on DL5+) and is resolved at
    runtime by DiagActivity.adasSendInfo().
    Hardcoded labels: power-user tool, not customer-facing — skip i18n.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ─── Status header card ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_outline_variant"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_stethoscope"
                        android:tint="@color/md_primary"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@null"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ADAS — fenêtre cluster"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Affiche ou masque la fenêtre ADAS du cluster Qt (codes AutoContainer 12 / 13, génériques DiLink)"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_on_surface_variant"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_adas_service_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="6dp" android:paddingBottom="6dp"
                        android:background="@drawable/bg_beta_pill"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:text="Auto_container"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_adas_show"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Afficher ADAS (12)"
                        app:icon="@drawable/ic_stethoscope"
                        app:iconGravity="textStart"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_adas_hide"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Masquer ADAS (13)"
                        app:icon="@drawable/ic_stethoscope"
                        app:iconGravity="textStart"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── Last result card ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_outline_variant"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dernier résultat"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/tv_adas_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="12dp"
                    android:background="@color/md_surface_container_high"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textColor="@color/md_on_surface_variant"
                    android:text="Aucun test exécuté.\nAppuie sur Afficher ADAS ou Masquer ADAS pour envoyer la commande au cluster."/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── Info card ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_outline_variant"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Détails techniques"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/md_on_surface_variant"
                    android:lineSpacingExtra="3dp"
                    android:text="• Commande shell : service call &lt;svc&gt; 2 i32 1000 i32 &lt;12|13&gt; s16 &quot;&quot;\n• Service : Auto_container sur DL3/Di4 (PascalCase), auto_container sur DL5+ (snake_case)\n• Code 12 = 显示Adas (Show ADAS) — généré par clusterdebug.SecondActivity.infoListInit()\n• Code 13 = 关闭Adas (Hide ADAS) — idem\n• Variants identiques : DL3 (infoListInit), Di4 (infoListInit), DL5 (infoListInit_Di5)\n• R-series : codes 12/13 stripés (slots vides) — non supporté ici"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
