<?xml version="1.0" encoding="utf-8"?>
<!--
    ADAS — diagnostic panel.
    Two tests wired on AutoContainer sendInfo codes 12 (show) / 13 (hide).
    Codes confirmed identical across all DiLink platforms (DL3/Di4/DL5/DL6)
    in com.byd.clusterdebug v1.6.1.4 — only the binder service name differs
    (Auto_container on DL3/Di4, auto_container on DL5+) and is resolved at
    runtime by DiagActivity.adasSendInfo().
    Hardcoded labels: power-user tool, not customer-facing — skip i18n.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ─── Status header card ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_outline_variant"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_stethoscope"
                        android:tint="@color/md_primary"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@null"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diag_adas_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diag_adas_description"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_on_surface_variant"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_adas_service_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="6dp" android:paddingBottom="6dp"
                        android:background="@drawable/bg_beta_pill"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:text="Auto_container"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_adas_show"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/diag_adas_btn_show"
                        app:icon="@drawable/ic_stethoscope"
                        app:iconGravity="textStart"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_adas_hide"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/diag_adas_btn_hide"
                        app:icon="@drawable/ic_stethoscope"
                        app:iconGravity="textStart"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── Last result card ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_outline_variant"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diag_adas_last_result"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/tv_adas_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="12dp"
                    android:background="@color/md_surface_container_high"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textColor="@color/md_on_surface_variant"
                    android:text="@string/diag_adas_no_test"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── Info card ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_outline_variant"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diag_adas_technical_details"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/md_on_surface_variant"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/diag_adas_doc_help"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
