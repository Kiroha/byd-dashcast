<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/md_surface_container"
    android:layout_marginBottom="6dp"
    android:padding="8dp">

    <!-- Preset name + slot count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_fission_preset_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_surface"/>

        <TextView
            android:id="@+id/tv_fission_preset_slots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/md_on_surface_variant"
            android:layout_marginEnd="8dp"/>

    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fission_activate"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/layout_preset_activate"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/md_primary"
            android:textColor="@color/md_on_primary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fission_edit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/fission_editor_edit"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fission_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/fission_editor_delete"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/md_error"/>

    </LinearLayout>

    <!-- Active slot details (shown only when layout activated) -->
    <LinearLayout
        android:id="@+id/ll_fission_active_slots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:visibility="gone"/>

</LinearLayout>
