    <!-- v1.2.10 — IME a11y onboarding banner (DL5) -->
    <string name="a11y_ime_watcher_label">Klaster auto-klawiatura (DashCast)</string>
    <string name="a11y_ime_watcher_summary">Pokazuje pomostową klawiaturę, gdy dotykasz pola tekstowego na klastrze.</string>
    <string name="a11y_ime_watcher_description">Obserwuje zdarzenia fokusu na ekranie klastra, aby automatycznie uruchomić most klawiatury DashCast. Nie odczytuje ani nie przechowuje zawartości pól.</string>
    <string name="ime_banner_title">Auto-klawiatura na klastrze</string>
    <string name="ime_banner_body">W tym pojeździe (DiLink 5) klawiatura systemowa nie może pojawić się na klastrze. Włącz usługę ułatwień dostępu, aby DashCast automatycznie otwierał most klawiatury, gdy dotykasz pola tekstowego. W przeciwnym razie użyj przycisku ⌨ w lustrze.</string>
    <string name="ime_banner_btn_enable">Włącz</string>
    <string name="ime_banner_btn_later">Później</string>
    <string name="ime_banner_btn_dismiss">Nie pokazuj ponownie</string>
    <string name="ime_banner_toast_enabled">Auto-klawiatura aktywna ✓</string>
    <string name="ime_banner_toast_cannot_open_settings">Nie można otworzyć Ustawień — włącz ręcznie usługę ułatwień dostępu „Klaster auto-klawiatura”.</string>
    <string name="hud_notif_banner_title">HUD Nawigacja — wymagany dostęp do powiadomień</string>
    <string name="hud_notif_banner_body">DashCast potrzebuje dostępu do powiadomień, aby wyświetlać wskazówki nawigacji na klastrze. Włącz w Ustawienia → Dostęp specjalny → Dostęp do powiadomień → DashCast.</string>
    <string name="hud_notif_banner_toast_enabled">Dostęp do powiadomień przyznany ✓</string>
