<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.2.x — Auto-launch badge background.
  Shown on app icons (list + grid items) when the user has marked the app
  as auto-launch (PREF_AUTO_LAUNCH_PKG). Tap-and-hold an app to toggle it
  from the action bottom sheet.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/auto_launch_badge_fill" />
    <stroke android:width="1dp" android:color="#FFFFFF" />
</shape>
